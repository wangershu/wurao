<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 应用列表：Android 11+ 的标准要求 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 应用列表：MIUI / HyperOS 自己加的运行时权限。
         只声明上一颗时，HyperOS 上 getInstalledPackages() 只返回自己这一个包。 -->
    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS"
        tools:ignore="MissingPermission" />
    <!-- 订阅下载 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="无扰"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- 写全名：namespace 是 com.wurao、applicationId 是 com.wurao.app，
             用相对名 ".ui.MainActivity" 会被按 applicationId 解析成
             com.wurao.app.ui.MainActivity，然后找不到 -->
        <!-- singleTop：调试直达靠 am start 传 extra，Activity 已在栈里时
             只有 singleTop 才会走 onNewIntent，否则直达会「看起来没反应」 -->
        <activity
            android:name="com.wurao.ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 命中记录的反向通道：目标进程 insert、界面 query。
             exported 是必须的（要让别的进程写），代价是没有权限保护 ——
             自用模块的取舍：换来的是任何被 hook 的进程都能把记录送回来。 -->
        


        <!-- 抓屏（检视层）：Xposed 读不到别的 App 的界面，这层必须靠无障碍。 -->
        <service
            android:name="com.wurao.assist.SnapshotService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/snapshot_service_config" />
        </service>
            <service
            android:name=".assist.FloatService"
            android:exported="false" />
        <!-- 命中回传：目标进程 insert，界面 query。exported 必须开 -->
        <provider
            android:name="com.wurao.ui.HitProvider"
            android:authorities="com.wurao.app.hits"
            android:exported="true"
            android:enabled="true" />

            <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="无扰：去广告" />
        <meta-data android:name="xposedminversion" android:value="93" />
            
    </application>
</manifest>
